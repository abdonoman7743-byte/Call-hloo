{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "call-hloo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "call-hloo"
    }
  ],
  "observability": {
    "enabled": true
  }
}
